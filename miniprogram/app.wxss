page {
  min-height: 100vh;
  background-color: #fff7f5;
  color: #2f2a2a;
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.container {
  min-height: 100vh;
  padding: 34rpx 28rpx 170rpx;
  box-sizing: border-box;
  background-color: #fff7f5;
}

.card {
  background: #ffffff;
  border-radius: 34rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(215, 127, 118, 0.12);
}

.title {
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #2d2525;
}

.subtitle {
  margin-top: 12rpx;
  color: #ad9a9a;
  font-size: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #3b3030;
}

.muted {
  color: #a79595;
  font-size: 27rpx;
}

.input,
.textarea {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
  background: #faf2f0;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  color: #3d3333;
}

.textarea {
  min-height: 170rpx;
}

.primary-btn {
  background: #ff6f85;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(255, 111, 133, 0.22);
}

.secondary-btn {
  background: #fff0ec;
  color: #d85e70;
  border-radius: 999rpx;
  font-weight: 800;
}

.ghost-btn {
  background: #ffffff;
  color: #7b6d6d;
  border-radius: 999rpx;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

.pill {
  display: inline-block;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0ec;
  color: #d85e70;
  font-size: 25rpx;
  font-weight: 700;
}
button, input, textarea {
  font-family: inherit;
}

button {
  font-size: 30rpx;
  line-height: 1.35;
}
