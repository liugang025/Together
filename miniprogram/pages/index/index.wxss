page {
  background: #fff7f5;
  color: #333333;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.muted {
  color: #888888;
  font-size: 29rpx;
}

.input {
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx 0;
}

.textarea {
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  min-height: 150rpx;
}

.primary-btn {
  background: #ff7f88;
  color: #ffffff;
  border-radius: 40rpx;
}

.secondary-btn {
  background: #fff0ec;
  color: #c65353;
  border-radius: 40rpx;
}

.ghost-btn {
  background: #ffffff;
  color: #666666;
  border-radius: 40rpx;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  background: #eeeeee;
}