.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 28rpx;
  background: #fff7f5;
}

.detail-card,
.photo-section {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(215, 127, 118, 0.08);
}

.detail-card {
  border: 1rpx solid #ffe4de;
}

.detail-card.is-done {
  border-color: #d7f0df;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.detail-title {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
  color: #2f2a2a;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx !important;
  font-weight: 800;
  background: #fff0ec;
  color: #ff6f85;
}

.status.done {
  background: #edf8f1;
  color: #48a46f;
}

.desc {
  margin-top: 18rpx;
  color: #6f6060;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 20rpx;
  width: 100%;
  margin-top: 24rpx;
}

.action-left,
.action-right {
  display: block;
  width: 100%;
  height: 58rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
  white-space: nowrap;
}

.action-left {
  background: #fff0ec;
  color: #ff6f85;
}

.action-right {
  background: #ff6f85;
  color: #ffffff;
}

.action-right.cancel {
  background: #fff0ec;
  color: #d85e70;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.photo-section .section-head {
  display: block;
}

.photo-heading {
  width: 100%;
}

.photo-header-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  margin-top: 20rpx;
}

.created-at {
  margin-top: 10rpx;
  color: #a79595;
  font-size: 23rpx;
}

.section-title {
  color: #2f2a2a;
  font-size: 34rpx;
  font-weight: 900;
}

.section-sub {
  margin-top: 8rpx;
  color: #a79595;
  font-size: 27rpx;
  line-height: 1.45;
}

.upload-btn {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  background: #2f2a2a;
  color: #ffffff;
  border-radius: 999rpx;
  box-shadow: none;
  font-size: 20rpx !important;
  font-weight: 800;
  line-height: 1 !important;
}

.upload-btn::after {
  border: 0;
}

.batch-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  margin-top: 12rpx;
}

.select-btn,
.batch-download,
.batch-delete {
  position: relative;
  display: block;
  min-width: 0;
  height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx !important;
  font-weight: 800;
  line-height: 1 !important;
}

.select-btn {
  width: 100%;
  border: 0;
  background: #fff0ec;
  color: #d85e70;
}

.select-btn.is-active {
  background: #fff3f0;
  color: #cf5268;
}

.batch-download {
  border: 1rpx solid #ffd7d0;
  background: #ffffff;
  color: #d85e70;
}

.batch-download,
.batch-delete {
  width: 100%;
  box-sizing: border-box;
  padding: 0;
}

.batch-delete {
  background: #413839;
  color: #ffffff;
  box-shadow: none;
}

.select-btn::after,
.batch-download::after,
.batch-delete::after {
  border: 0;
}

.button-label {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  display: block;
  transform: translateY(-50%);
  line-height: 1;
  text-align: center;
}

.batch-toolbar {
  display: block;
  padding: 4rpx 2rpx 20rpx;
  margin: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.batch-meta {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.select-all-btn {
  position: relative;
  display: block;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 40rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #ffd7d0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #d85e70;
  font-size: 19rpx !important;
  font-weight: 800;
  line-height: 1 !important;
}

.select-all-btn::after {
  border: 0;
}

.selection-count {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: #6f6060;
  font-size: 19rpx;
  font-weight: 800;
}

.selection-number {
  margin: 0 3rpx;
  color: #ff6f85;
  font-size: 23rpx;
}

.original-option {
  white-space: nowrap;
  color: #9d8586;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.original-option label {
  display: flex;
  align-items: center;
  height: 48rpx;
}

.original-option checkbox {
  transform: scale(0.74);
  margin-right: -7rpx;
}

.empty-photo {
  padding: 46rpx 0;
  border-radius: 24rpx;
  background: #fbf3f1;
  color: #a79595;
  text-align: center;
}

.empty-icon {
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #ff6f85;
  font-size: 36rpx;
  line-height: 62rpx;
}

.empty-title {
  color: #a79595;
  font-size: 27rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-loading-more {
  padding: 24rpx 0 4rpx;
  color: #a79595;
  font-size: 24rpx;
  text-align: center;
}

.photo-item {
  position: relative;
  width: 31%;
  height: 200rpx;
}

.photo-item.selected .photo {
  box-shadow: 0 0 0 5rpx #ff6f85, 0 12rpx 30rpx rgba(215, 127, 118, 0.2);
}

.photo-checkbox {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  z-index: 3;
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: rgba(47, 42, 42, 0.62);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: center;
}

.photo-item.selected .photo-checkbox {
  border-color: #ff6f85;
  background: #ff6f85;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  background: #f5e6e2;
}

.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b89b9b;
  font-size: 24rpx;
}

.video-thumb {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  margin: -28rpx 0 0 -28rpx;
  border-radius: 50%;
  color: #fff;
  background: rgba(0, 0, 0, .48);
  text-align: center;
  line-height: 56rpx;
  font-size: 24rpx;
}

.description-card {
  padding: 28rpx;
}

.description-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.description-edit {
  flex-shrink: 0;
  min-width: 86rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff0ec;
  color: #ff6f85;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
}

.description-text {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f6;
  color: #4c3f3f;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-all;
}

.description-empty {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f6;
  color: #b09b9a;
  font-size: 28rpx;
  line-height: 1.5;
}

.upload-progress-dock {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  overflow: hidden;
  border: 1rpx solid rgba(255, 215, 208, 0.9);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 36rpx rgba(70, 45, 45, 0.18);
}

.upload-progress-details {
  padding: 24rpx 26rpx 0;
}

.upload-progress-heading,
.upload-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.upload-progress-title {
  color: #342d2d;
  font-size: 28rpx;
  font-weight: 800;
}

.upload-progress-summary,
.upload-photo-percent {
  color: #d85e70;
  font-size: 22rpx;
  font-weight: 700;
}

.upload-progress-list {
  max-height: 42vh;
  margin-top: 8rpx;
}

.upload-progress-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5e8e6;
}

.upload-photo-name {
  max-width: 78%;
  overflow: hidden;
  color: #514747;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-progress-track {
  height: 8rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f7e9e6;
}

.upload-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff9a9e, #ff6f85);
  transition: width 180ms ease;
}

.upload-photo-status {
  margin-top: 7rpx;
  color: #a79595;
  font-size: 20rpx;
}

.upload-progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 98rpx;
  padding: 0 28rpx;
}

.upload-bar-title {
  color: #342d2d;
  font-size: 25rpx;
  font-weight: 800;
}

.upload-bar-meta {
  margin-top: 5rpx;
  color: #a08080;
  font-size: 21rpx;
}

.upload-bar-dismiss {
  width: 54rpx;
  height: 54rpx;
  color: #a08080;
  font-size: 42rpx;
  line-height: 48rpx;
  text-align: center;
}

.safety-check-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 750px;
  height: 1334px;
  opacity: 0;
  pointer-events: none;
}
