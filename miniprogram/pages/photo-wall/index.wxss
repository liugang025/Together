.photo-page {
  padding-top: 28rpx;
  padding-bottom: 150rpx;
}

.photo-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx;
  margin-bottom: 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #2f2a2a, #49393d);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(47, 42, 42, 0.18);
  position: relative;
}

.eyebrow {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  letter-spacing: 4rpx;
  opacity: 0.6;
}

.hero-title {
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-subtitle {
  margin-top: 14rpx;
  max-width: 390rpx;
  font-size: 23rpx;
  line-height: 1.45;
  opacity: 0.78;
}


.create-album-btn {
  min-width: 138rpx;
  background: #ff6f85;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(255, 104, 130, 0.24);
  position: relative;
  z-index: 20;
  pointer-events: auto;
}

.create-album-btn::after {
  border: 0;
}

.section-block {
  margin-bottom: 26rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  color: #2f2a2a;
  font-size: 34rpx;
  font-weight: 900;
}

.section-sub {
  margin-top: 8rpx;
  color: #a79595;
  font-size: 28rpx;
}

.empty-mini {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #a79595;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 10rpx 26rpx rgba(215, 127, 118, 0.08);
  pointer-events: none;
}

.album-list {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.album-card {
  position: relative;
  flex: 0 0 260rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(215, 127, 118, 0.1);
}

.album-cover {
  width: 100%;
  height: 170rpx;
  background: #fff0ec;
}

.empty-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6f85;
  font-size: 52rpx;
}

.empty-cover,
.todo-album-placeholder {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-info {
  padding: 18rpx;
}

.album-name {
  color: #2f2a2a;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-count {
  margin-top: 8rpx;
  color: #a79595;
  font-size: 26rpx;
}

.empty-photo-card {
  margin-top: 16rpx;
  padding: 64rpx 42rpx 58rpx;
  border-radius: 38rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.1);
  pointer-events: none;
}

.album-illus {
  position: relative;
  width: 210rpx;
  height: 150rpx;
  margin: 0 auto 34rpx;
}

.album-paper {
  position: absolute;
  width: 150rpx;
  height: 108rpx;
  border-radius: 22rpx;
  background: #fff0ec;
}

.album-paper.one {
  left: 18rpx;
  top: 24rpx;
  transform: rotate(-9deg);
}

.album-paper.two {
  right: 12rpx;
  top: 6rpx;
  background: #ff8798;
  transform: rotate(8deg);
}

.album-heart {
  position: absolute;
  left: 78rpx;
  top: 36rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #ff6f85;
  font-size: 44rpx;
  box-shadow: 0 8rpx 22rpx rgba(215, 127, 118, 0.16);
}

.empty-title {
  margin-bottom: 12rpx;
  color: #2f2a2a;
  font-size: 36rpx;
  font-weight: 900;
}

.empty-desc {
  color: #a79595;
  font-size: 29rpx;
  line-height: 1.6;
}

.todo-album-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.todo-album-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.12);
}

.todo-album-cover-wrap {
  position: relative;
  height: 230rpx;
  background: #f5e6e2;
}

.todo-album-cover {
  width: 100%;
  height: 100%;
  background: #f5e6e2;
}

.todo-album-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b89b9b;
  font-size: 24rpx;
}

.todo-album-badge {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 42, 42, 0.78);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.todo-album-info {
  padding: 18rpx;
}

.todo-album-title {
  color: #3b3030;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
