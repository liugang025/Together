.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 24rpx;
  padding-bottom: 150rpx;
  background: radial-gradient(circle at 82% 8%, rgba(255, 147, 165, 0.18), transparent 30%), linear-gradient(180deg, #fff7f5 0%, #fffaf9 48%, #ffffff 100%);
}

.space-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx;
  margin-bottom: 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #fff1ee 0%, #fff9f7 66%, #ffffff 100%);
  border: 1rpx solid rgba(255, 218, 210, 0.95);
  box-shadow: 0 14rpx 36rpx rgba(215, 127, 118, 0.09);
}

.space-hero::after {
  content: "";
  position: absolute;
  right: -46rpx;
  bottom: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 111, 133, 0.1);
  pointer-events: none;
}

.hero-kicker {
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
  color: #ff7890;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  max-width: 470rpx;
  color: #2f2a2a;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.hero-desc {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  max-width: 500rpx;
  color: #8f7f7f;
  font-size: 29rpx;
  line-height: 1.55;
}

.couple-card {
  padding: 34rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.1);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  color: #2f2a2a;
  font-size: 34rpx;
  font-weight: 900;
}

.section-sub {
  margin-top: 8rpx;
  color: #a79595;
  font-size: 28rpx;
}

.joined-badge {
  flex-shrink: 0;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0ec;
  color: #d85e70;
  font-size: 26rpx;
  font-weight: 900;
}

.joined-badge.active {
  background: #edf8f1;
  color: #48a46f;
}

.people-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.person-card {
  transition: transform 0.16s ease;
  flex: 1;
  min-width: 0;
  min-height: 210rpx;
  box-sizing: border-box;
  padding: 24rpx 14rpx;
  border-radius: 30rpx;
  background: #fff8f6;
  text-align: center;
  border: 1rpx solid rgba(255, 226, 220, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.person-card.partner {
  background: #ffffff;
}

.person-card.empty {
  background: #fbf6f5;
}

.person-avatar {
  width: 100rpx;
  height: 100rpx;
  margin: 0;
  border-radius: 50%;
  background: #ffeff1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-avatar {
  color: #ff6f85;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 100rpx;
  text-align: center;
}

.text-avatar.muted {
  background: #f4eeee;
  color: #b7a5a5;
}

.person-name {
  color: #2f2a2a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.person-hint {
  margin-top: 9rpx;
  color: #a79595;
  font-size: 23rpx;
  line-height: 1.35;
}

.heart-link {
  width: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6f85;
  font-size: 42rpx;
  font-weight: 900;
}


.invite-line {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8f6;
  color: #3d3333;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  border: 1rpx solid rgba(255, 226, 220, 0.95);
  text-align: left;
}

.invite-line::after {
  border: 0;
}

.invite-action {
  color: #ff6f85;
  font-size: 26rpx;
  font-weight: 900;
}



.nickname-input {
  width: 86%;
  height: 48rpx;
  min-height: 48rpx;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #ff6f85;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.nickname-input-placeholder {
  color: #ff8fa0;
  font-size: 24rpx;
  font-weight: 800;
}


.avatar-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 14rpx;
}

.avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  width: 100rpx !important;
  height: 100rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: 100rpx !important;
  max-height: 100rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  border-radius: 50% !important;
  background: transparent !important;
  background-color: transparent !important;
  color: transparent !important;
  font-size: 0 !important;
  line-height: 0 !important;
  opacity: 0.01;
  overflow: hidden;
  z-index: 2;
}

.avatar-picker::after {
  border: 0 !important;
  background: transparent !important;
}


.nickname-button {
  max-width: 148rpx;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #ff6f85;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.invite-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.1);
}

.invite-title {
  color: #2f2a2a;
  font-size: 31rpx;
  font-weight: 900;
}

.invite-desc {
  margin-top: 8rpx;
  color: #a79595;
  font-size: 25rpx;
  line-height: 1.4;
}

.invite-copy {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ff6f85;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.invite-copy::after {
  border: 0;
}

.time-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.1);
}

.time-head {
  margin-bottom: 24rpx;
}

.time-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.time-item {
  position: relative;
  overflow: hidden;
  min-height: 210rpx;
  box-sizing: border-box;
  padding: 24rpx 18rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #fff7f5, #ffffff);
  border: 1rpx solid rgba(255, 226, 220, 0.95);
}

.time-item::after {
  content: "";
  position: absolute;
  right: -42rpx;
  top: -46rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 111, 133, 0.1);
}

.time-item.love {
  background: linear-gradient(145deg, #fff0f3, #ffffff);
}

.time-label {
  position: relative;
  z-index: 1;
  color: #ff6f85;
  font-size: 28rpx;
  font-weight: 900;
}

.time-date {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  color: #a79595;
  font-size: 22rpx;
  font-weight: 800;
}

.time-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.time-days {
  color: #2f2a2a;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.time-unit {
  margin-left: 8rpx;
  color: #6f6060;
  font-size: 25rpx;
  font-weight: 900;
}

.time-clock {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: #3d3333;
  font-size: 27rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.time-clock .colon {
  margin: 0 5rpx;
  color: #ff8fa0;
}

.particle-heart {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  margin: 10rpx 0 24rpx;
  background: transparent;
}

.particle-heart-image {
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 300rpx;
  height: 286rpx;
  z-index: 1;
  transform: translateX(-50%) scale(1);
  transform-origin: center center;
  animation: heart-art-beat 1.75s cubic-bezier(0.36, 0, 0.22, 1) infinite;
}

.heart-dust-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  z-index: 2;
  pointer-events: none;
}

.heart-dust {
  position: absolute;
  border-radius: 50%;
  background: #ff6f85;
  box-shadow: 0 0 10rpx rgba(255, 111, 133, 0.7);
  opacity: 0;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.heart-dust.a { animation-name: heart-dust-a; }
.heart-dust.b { animation-name: heart-dust-b; background: #ff9bab; }
.heart-dust.c { animation-name: heart-dust-c; background: #f58aa0; }

.particle-heart-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8rpx;
  z-index: 3;
  color: #c7959e;
  text-shadow: none;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  text-align: center;
}

@keyframes heart-art-beat {
  0%, 100% { transform: translateX(-50%) scale(1); }
  12% { transform: translateX(-50%) scale(1.065); }
  22% { transform: translateX(-50%) scale(1.012); }
  33% { transform: translateX(-50%) scale(1.042); }
  45% { transform: translateX(-50%) scale(1); }
}

@keyframes heart-dust-a {
  0% { opacity: 0; transform: translate3d(-8rpx, 14rpx, 0) scale(0.6); }
  24% { opacity: 0.78; }
  68% { opacity: 0.44; }
  100% { opacity: 0; transform: translate3d(14rpx, -28rpx, 0) scale(1.3); }
}

@keyframes heart-dust-b {
  0% { opacity: 0; transform: translate3d(12rpx, -8rpx, 0) scale(0.7); }
  30% { opacity: 0.66; }
  72% { opacity: 0.38; }
  100% { opacity: 0; transform: translate3d(-18rpx, 24rpx, 0) scale(1.2); }
}

@keyframes heart-dust-c {
  0% { opacity: 0; transform: translate3d(0, 18rpx, 0) scale(0.5); }
  32% { opacity: 0.7; }
  70% { opacity: 0.42; }
  100% { opacity: 0; transform: translate3d(8rpx, -22rpx, 0) scale(1.4); }
}
