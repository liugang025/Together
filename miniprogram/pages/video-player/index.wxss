page {
  width: 100%;
  height: 100%;
  background: #000;
}

.player-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.media-stage {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.media-image,
.player {
  width: 100%;
  height: 100%;
}

.media-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.carousel-viewport {
  position: absolute;
  z-index: 5;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background: #000;
}

.carousel-track {
  display: flex;
  width: 300%;
  height: 100%;
  will-change: transform;
}

.carousel-card {
  position: relative;
  flex: 0 0 33.333333%;
  height: 100%;
  background: #000;
}

.carousel-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.loading {
  color: #fff;
  font-size: 28rpx;
}

.nav-button {
  position: absolute;
  top: 50%;
  width: 76rpx;
  height: 100rpx;
  margin-top: -50rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.28);
  color: #fff;
  font-size: 72rpx;
  line-height: 88rpx;
  text-align: center;
}

.nav-button.previous {
  left: 12rpx;
}

.nav-button.next {
  right: 12rpx;
}
