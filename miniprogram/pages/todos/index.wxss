.todos-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 20rpx;
  padding-bottom: 150rpx;
  background: radial-gradient(circle at 86% 7%, rgba(255, 154, 170, 0.18), transparent 28%), linear-gradient(180deg, #fff7f4 0%, #fffbfa 45%, #ffffff 100%);
}

.soft-hero {
  position: relative;
  box-sizing: border-box;
  padding: 30rpx 28rpx;
  margin: 0 0 18rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #fff1ee 0%, #fff8f6 62%, #ffffff 100%);
  border: 1rpx solid rgba(255, 211, 203, 0.9);
  box-shadow: 0 12rpx 34rpx rgba(255, 137, 145, 0.08);
}

.soft-hero::after {
  content: "";
  position: absolute;
  right: -54rpx;
  bottom: -64rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 119, 140, 0.1);
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding-right: 170rpx;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: #ff758c;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.hero-title {
  color: #2c2828;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 10rpx;
  color: #937f7e;
  font-size: 28rpx;
  line-height: 1.5;
}

.add-float {
  position: absolute;
  z-index: 20;
  right: 24rpx;
  top: 36rpx;
  min-width: 168rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff91a3, #ff627c);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 60rpx;
  box-shadow: 0 10rpx 22rpx rgba(255, 104, 130, 0.24);
}

.add-float::after {
  border: 0;
}

.stats-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 18rpx 14rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(210, 122, 112, 0.07);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  color: #2c2828;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  color: #a69493;
  font-size: 25rpx;
}

.stat-line {
  width: 1rpx;
  height: 40rpx;
  background: #f1dfdc;
}

.filters {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 18rpx;
  white-space: nowrap;
}

.filter {
  min-width: 82rpx;
  box-sizing: border-box;
  padding: 11rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #9f8f8e;
  font-size: 27rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(210, 122, 112, 0.05);
}

.filter.active {
  background: #302b2b;
  color: #ffffff;
  font-weight: 900;
}

.todo-list {
  width: 100%;
}

.swipe-row {
  position: relative;
  width: 100%;
  min-height: 108rpx;
  margin: 0 0 14rpx;
  overflow: hidden;
  border-radius: 28rpx;
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease;
  will-change: transform;
}

.actions-panel {
  position: absolute;
  top: 10rpx;
  right: 0;
  bottom: 10rpx;
  width: 164rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  opacity: 0;
  transform: translateX(18rpx) scale(0.96);
  transition: opacity 0.18s ease, transform 0.22s ease;
  pointer-events: none;
  z-index: 3;
}

.swipe-row.opened .actions-panel {
  opacity: 1;
  transform: translateX(0) scale(1);
  pointer-events: auto;
}

.action-btn {
  width: 72rpx;
  height: 64rpx;
  border-radius: 22rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 18rpx rgba(65, 46, 50, 0.12);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.action-symbol {
  display: none;
}

.complete-action {
  background: linear-gradient(180deg, #6edb98, #36b86b);
}

.complete-action.cancel {
  background: linear-gradient(180deg, #e6b56e, #d59547);
}

.delete-action {
  background: linear-gradient(180deg, #40383a, #2b2527);
}

.todo-card {
  position: relative;
  z-index: 2;
  min-height: 108rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(255, 250, 249, 0.98));
  border: 1rpx solid rgba(255, 224, 218, 0.95);
  box-shadow: 0 12rpx 28rpx rgba(219, 124, 116, 0.09);
  transform: translateX(0);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
  display: flex;
  align-items: center;
}

.todo-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 7rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: linear-gradient(180deg, #ff9bae, #ff6f85);
  pointer-events: none;
}

.swipe-row.opened .todo-card,
.todo-card.opened-card {
  transform: translateX(-176rpx);
  box-shadow: 0 10rpx 22rpx rgba(219, 124, 116, 0.08);
}

.todo-card.is-done {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(249, 255, 251, 0.98));
  border-color: rgba(195, 233, 207, 0.95);
  box-shadow: 0 14rpx 30rpx rgba(83, 168, 117, 0.09);
}

.todo-card.is-done::before {
  background: linear-gradient(180deg, #75d79c, #45b873);
}

.todo-dot {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #fff0f2;
  color: #ff7188;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 135, 153, 0.16);
}

.todo-dot.done {
  background: #edf8f1;
  color: #49aa72;
  box-shadow: inset 0 0 0 1rpx rgba(73, 170, 114, 0.16);
}

.todo-body {
  flex: 1;
  min-width: 0;
}

.todo-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.todo-title {
  flex: 1;
  min-width: 0;
  padding-right: 14rpx;
  color: #2f2a2a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.todo-title.done {
  color: #2f2a2a;
  text-decoration: none;
}

.status-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff0ec;
  color: #ff6f85;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.status-badge.done {
  background: #edf8f1;
  color: #48a46f;
}

.todo-desc {
  margin-top: 8rpx;
  color: #847474;
  font-size: 27rpx;
  line-height: 1.45;
  word-break: break-all;
}

.empty-card {
  margin: 24rpx 0 0;
  padding: 58rpx 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(215, 127, 118, 0.07);
}

.empty-icon {
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  background: #fff0ec;
  color: #ff6f85;
  font-size: 42rpx;
  line-height: 82rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #2f2a2a;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  color: #a79595;
  font-size: 28rpx;
  line-height: 1.55;
}


.swipe-row {
  position: relative;
  width: 100%;
  min-height: 108rpx;
  margin: 0 0 14rpx;
  overflow: hidden;
  border-radius: 28rpx;
}

.actions-panel {
  position: absolute;
  top: 8rpx;
  right: 0;
  bottom: 8rpx;
  width: 72rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  opacity: 0;
  transform: translateX(18rpx);
  transition: opacity 0.18s ease, transform 0.22s ease;
  pointer-events: none;
  z-index: 3;
}

.swipe-row.opened .actions-panel {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.action-btn {
  flex: 1;
  min-height: 42rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(65, 46, 50, 0.12);
}

.complete-action {
  background: linear-gradient(180deg, #6edb98, #36b86b);
}

.complete-action.cancel {
  background: linear-gradient(180deg, #e6b56e, #d59547);
}

.delete-action {
  background: linear-gradient(180deg, #40383a, #2b2527);
}

.swipe-row .todo-card {
  width: 100%;
}

.swipe-row.opened .todo-card {
  transform: translateX(-82rpx);
}

.swipe-row.dragging {
  opacity: 0.96;
  z-index: 8;
  overflow: visible;
  transition: transform 0.08s linear, opacity 0.18s ease;
}

.swipe-row.dragging .todo-card {
  box-shadow: 0 22rpx 48rpx rgba(219, 124, 116, 0.2);
  border-color: rgba(255, 151, 168, 0.5);
}

.todo-list.is-sorting .swipe-row:not(.dragging) {
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease;
}
