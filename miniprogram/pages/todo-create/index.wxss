.create-page {
  padding-top: 24rpx;
}

.soft-hero {
  padding: 38rpx 34rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: #fff4f1;
  border: 1rpx solid #ffe4de;
}

.hero-kicker {
  color: #ff7890;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  color: #2f2a2a;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hero-desc {
  margin-top: 14rpx;
  color: #8f7f7f;
  font-size: 30rpx;
  line-height: 1.6;
}

.form-card {
  padding: 34rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(215, 127, 118, 0.10);
}

.field-label {
  margin: 6rpx 0 14rpx;
  color: #3b3030;
  font-size: 28rpx;
  font-weight: 900;
}

.input {
  height: 82rpx;
  min-height: 82rpx;
  line-height: 42rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  background: #fbf3f1;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 230rpx;
  line-height: 42rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
  background: #fbf3f1;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 18rpx;
  background: #ff6f85;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(255, 111, 133, 0.20);
}